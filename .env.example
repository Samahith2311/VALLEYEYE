# Copernicus Data Space credentials are optional for public catalogue searches.
CDSE_USERNAME=your-cdse-username
CDSE_PASSWORD=your-cdse-password
CDSE_TOTP=

# These service URLs and collection IDs are documented in docs/DATA_SOURCES.md.
VALLEYEYE_CDSE_IDENTITY_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
VALLEYEYE_CDSE_CLIENT_ID=cdse-public
VALLEYEYE_STAC_API_URL=https://stac.dataspace.copernicus.eu/v1
VALLEYEYE_S1_COLLECTION=sentinel-1-grd
VALLEYEYE_S2_COLLECTION=sentinel-2-l2a

# Upstream request and token settings.
VALLEYEYE_HTTP_TIMEOUT_SECONDS=30
VALLEYEYE_RETRY_MAX_ATTEMPTS=4
VALLEYEYE_TOKEN_REFRESH_SKEW_SECONDS=60

# Search and AOI limits; values are intentionally configurable.
VALLEYEYE_S1_INITIAL_WINDOW_DAYS=12
VALLEYEYE_S1_MAX_WINDOW_DAYS=96
VALLEYEYE_S1_WINDOW_MULTIPLIER=2
VALLEYEYE_MIN_S1_AOI_COVERAGE=0.8
VALLEYEYE_MIN_AOI_AREA_KM2=0.1
VALLEYEYE_MAX_AOI_AREA_KM2=5000
VALLEYEYE_PAIR_LONG_GAP_WARNING_DAYS=24
VALLEYEYE_PAIR_WEIGHT_OVERLAP=0.25
VALLEYEYE_PAIR_WEIGHT_PRE_CLOSENESS=0.25
VALLEYEYE_PAIR_WEIGHT_POST_CLOSENESS=0.25
VALLEYEYE_PAIR_WEIGHT_SAME_PLATFORM=0.1
VALLEYEYE_PAIR_WEIGHT_COVERAGE=0.15
