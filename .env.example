# Copernicus Data Space credentials are optional for public catalogue searches.
CDSE_USERNAME=your-cdse-username
CDSE_PASSWORD=your-cdse-password
CDSE_TOTP=

# These service URLs and collection IDs are documented in docs/DATA_SOURCES.md.
VALLEYEYE_CDSE_IDENTITY_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
VALLEYEYE_CDSE_CLIENT_ID=cdse-public
VALLEYEYE_STAC_API_URL=https://stac.dataspace.copernicus.eu/v1
VALLEYEYE_S1_COLLECTION=sentinel-1-grd
VALLEYEYE_S2_COLLECTION=sentinel-2-l2a

# Historical OSM extraction; obtain a free key from HeiGIT before live use.
OHSOME_API_KEY=your-ohsome-api-key
VALLEYEYE_OHSOME_API_URL=https://api.heigit.org/ohsome-api/v2-rc
VALLEYEYE_OHSOME_TIMEOUT_SECONDS=240
VALLEYEYE_OSM_AOI_BUFFER_M=5000

# Upstream request and token settings.
VALLEYEYE_HTTP_TIMEOUT_SECONDS=30
VALLEYEYE_RETRY_MAX_ATTEMPTS=4
VALLEYEYE_TOKEN_REFRESH_SKEW_SECONDS=60

# Search and AOI limits; values are intentionally configurable.
VALLEYEYE_S1_INITIAL_WINDOW_DAYS=12
VALLEYEYE_S1_MAX_WINDOW_DAYS=96
VALLEYEYE_S1_WINDOW_MULTIPLIER=2
VALLEYEYE_MIN_S1_AOI_COVERAGE=0.8
VALLEYEYE_MIN_AOI_AREA_KM2=0.1
VALLEYEYE_MAX_AOI_AREA_KM2=5000
VALLEYEYE_PAIR_LONG_GAP_WARNING_DAYS=24
VALLEYEYE_PAIR_WEIGHT_OVERLAP=0.25
VALLEYEYE_PAIR_WEIGHT_PRE_CLOSENESS=0.25
VALLEYEYE_PAIR_WEIGHT_POST_CLOSENESS=0.25
VALLEYEYE_PAIR_WEIGHT_SAME_PLATFORM=0.1
VALLEYEYE_PAIR_WEIGHT_COVERAGE=0.15

# Phase 2 model and raster processing.
VALLEYEYE_MODEL_WEIGHTS_PATH=weights/kuro-siwo-snunet.pt
VALLEYEYE_INFERENCE_DEVICE=auto
VALLEYEYE_FLOOD_PROBABILITY_THRESHOLD=0.5
VALLEYEYE_INFERENCE_TILE_SIZE=224
VALLEYEYE_INFERENCE_OVERLAP=32
VALLEYEYE_SNAP_GPT_PATH=
VALLEYEYE_SNAP_PIXEL_SPACING_M=10
VALLEYEYE_SNAP_AOI_BUFFER_M=500
VALLEYEYE_MINIMUM_FLOOD_POLYGON_AREA_KM2=0.001
VALLEYEYE_CANDIDATE_BACKSCATTER_CHANGE_THRESHOLD_DB=3.0
VALLEYEYE_MINIMUM_CANDIDATE_POLYGON_AREA_KM2=0.001

# OSM exposure and road-network thresholds.
VALLEYEYE_BUILDING_AFFECTED_FRACTION_THRESHOLD=0.1
VALLEYEYE_ROAD_POTENTIALLY_BLOCKED_FRACTION=0.01
VALLEYEYE_ROAD_BLOCKED_FRACTION=0.5
VALLEYEYE_BRIDGE_HAZARD_BUFFER_M=20
VALLEYEYE_BRIDGE_BLOCK_ON_INTERSECTION=true
VALLEYEYE_NETWORK_MAX_SNAP_DISTANCE_M=500
VALLEYEYE_NETWORK_DETOUR_RATIO_THRESHOLD=1.25
VALLEYEYE_REMOVE_POTENTIALLY_BLOCKED_EDGES=false
VALLEYEYE_ROAD_SPEED_DEFAULTS_KMH={"motorway":90,"trunk":70,"primary":60,"secondary":50,"tertiary":40,"unclassified":30,"residential":30,"service":20,"track":15}
